# Copie para .env (na raiz do projeto) e preencha. O .env não vai para o Git.

# --- Modelo de IA (Google Gemini) -------------------------------------------
# Chave em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
NEXO_MODEL=gemini-flash-lite-latest
# Usado se o principal falhar ou demorar a responder.
NEXO_FALLBACK_MODEL=gemini-3.5-flash

# --- App web (Next.js) -------------------------------------------------------
# Segredo para assinar o cookie de sessão. Gere com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-segredo
WEB_DB_PATH=../../data/web.db
# Abaixo deste grau de confiança o agent não decide sozinho e chama um analista.
NEXO_MIN_CONFIDENCE=0.6
# Teto de respostas do agent por dia (todos os usuários juntos), para proteger a chave.
NEXO_DAILY_TURN_LIMIT=500
# Cookie de sessão só por HTTPS (padrão: ligado em produção). Use false se servir em HTTP puro.
# COOKIE_SECURE=false

# --- Serviço de chamados (o "legado" simulado) ------------------------------
TICKETS_URL=http://127.0.0.1:4001
TICKETS_PORT=4001
TICKETS_SERVICE_TOKEN=troque-este-token
TICKETS_DB_PATH=../../data/tickets.db
# Chance de cada requisição abrir uma janela de indisponibilidade, e quanto ela dura.
TICKETS_OUTAGE_CHANCE=0.03
TICKETS_OUTAGE_MS=4000

# --- Docker Compose ----------------------------------------------------------
# Endereço e porta publicados no host (padrão 127.0.0.1:3000, atrás de um proxy).
# NEXO_BIND=127.0.0.1
# NEXO_PORT=3000
